<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Hercules</RootNamespace>
    <AssemblyName>Hercules</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Вложенные проекты (Web API и фронтенд) исключаем из сборки ядра,
         иначе SDK подхватит их .cs-файлы через стандартный globbing. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Hercules.WebApi/**;hercules-web/**;SkillSdk/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hercules.Agent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Skill SDK: whitelist API for file-based C# skills (task_101) -->
    <ProjectReference Include="SkillSdk\Hercules.SkillSdk.csproj" />

    <!-- AI-абстракции: единый интерфейс IChatClient для всех LLM-провайдеров -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <!-- OpenAI-совместимый SDK (используется для YandexGPT и Ollama) -->

    <!-- In-process C# compilation for SkillSdkExecutor (task_101) -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />

    <!-- Хостинг, DI, конфигурация -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <!-- task_078: standard resilience handlers (retry + circuit breaker + timeout) for named HttpClient clients -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.0.0" />

    <!-- SQLite для логов сессий и метрик -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Wasmtime" Version="44.0.0" />

    <!-- Парсинг метаданных навыков (YAML front-matter) -->
    <PackageReference Include="YamlDotNet" Version="18.1.0" />

    <!-- Object pooling for hot-path StringBuilder (task_084) -->
    <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="10.0.11" />

    <!-- Улучшенный CLI-интерфейс -->
    <PackageReference Include="Spectre.Console" Version="0.57.2" />

    <!-- Telegram-бот (вторичный интерфейс) -->
    <PackageReference Include="Telegram.Bot" Version="22.10.2.1" />

    <!-- Model Context Protocol (MCP) — Stage 3, tool ecosystem -->
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />

    <!-- gRPC transport (task_037) -->
    <PackageReference Include="Grpc.Net.Client" Version="2.83.0" />

    <!-- Redis/Valkey backend (task_067) — RESP-compatible pub/sub, state store, task queue -->
    <PackageReference Include="StackExchange.Redis" Version="3.1.13" />

    <!-- NATS/JetStream backend (task_068) — subject-based routing, durable streams, KV store -->
    <PackageReference Include="NATS.Client.Core" Version="3.1.0" />
    <PackageReference Include="NATS.Client.JetStream" Version="3.1.0" />
    <PackageReference Include="NATS.Client.KeyValueStore" Version="3.1.0" />

    <!-- PostgreSQL shared state backend (task_069) — JSONB state, SELECT FOR UPDATE SKIP LOCKED queues, LISTEN/NOTIFY bus -->
    <PackageReference Include="Npgsql" Version="10.0.3" />

    <!-- OpenTelemetry (task_013) — tracing, metrics, structured logs -->
    <PackageReference Include="OpenTelemetry" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Process" Version="1.10.0-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Конфигурация копируется в выходную директорию -->
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
