<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Hercules.WebApi</RootNamespace>
    <AssemblyName>Hercules.WebApi</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- [task_109] OpenAPI build-time generation: emits openapi.json in project root on `dotnet build` -->
    <OpenApiDocumentFile>$(MSBuildProjectDirectory)/openapi.json</OpenApiDocumentFile>

    <!-- [task_109] XML doc comments → OpenAPI descriptions; suppress missing-doc warnings
         (not every public member needs OpenAPI docs) -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;1573</NoWarn>
    <UserSecretsId>ce26d6d3-3657-4fc3-bc3a-9b72a43f3a7e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ссылка на ядро агента: переиспользуем Agent/LLM/Storage и WebApiAdapter -->
    <ProjectReference Include="..\Hercules.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- [task_109] Scalar UI for /scalar endpoint -->
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.20" />
    <!-- [task_109] Microsoft.AspNetCore.OpenApi (built-in .NET 10) for AddOpenApi/MapOpenApi -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
  </ItemGroup>

  <!-- [task_109] Build-time OpenAPI document generation.

       Replaces Microsoft.Extensions.ApiDescription.Server, whose `dotnet-getdocument`
       tool resolves the document through MVC's action-descriptor provider. This API
       surface is 100% minimal API, so the tool logged "No action descriptors found" and
       wrote a document with `paths: {}` — 210 endpoints missing from the committed file.

       Instead we launch the app itself with the `openapi-output` command-line flag
       (see ReadOpenApiOutputPath in Program.cs). Program.cs then resolves
       IOpenApiDocumentProvider — the same provider backing the runtime
       /openapi/v1.json endpoint — so the committed document cannot drift from the
       document the server actually serves.

       Skipped for design-time builds and when OpenApiGenerateDocumentOnBuild=false. -->
  <Target Name="GenerateOpenApiDocument"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true' AND '$(TargetFramework)' != '' AND '$(OpenApiGenerateDocumentOnBuild)' != 'false'">
    <Message Importance="high" Text="GenerateOpenApiDocument: writing $(OpenApiDocumentFile)" />
    <Exec Command="&quot;$(DOTNET_HOST_PATH)&quot; &quot;$(TargetPath)&quot; --openapi-output &quot;$(OpenApiDocumentFile)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          StandardOutputImportance="low" />
  </Target>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
