{
  "name": "hercules-studio",
  "version": "0.1.0",
  "description": "Hercules Studio — IDE for managing, configuring, and orchestrating Hercules AI agents",
  "type": "module",
  "license": "AGPL-3.0",
  "author": "Victor V (techbuzzz)",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder",
    "package:win": "electron-vite build && electron-builder --win",
    "package:portable": "electron-vite build && electron-builder --win portable",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "dependencies": {
    "@guolao/vue-monaco-editor": "^1.0.0",
    "@tabler/icons-vue": "^3.0.0",
    "@vue-flow/core": "^1.0.0",
    "better-sqlite3": "^11.0.0",
    "highlight.js": "^11.0.0",
    "markdown-it": "^14.0.0",
    "monaco-editor": "^0.50.0",
    "ofetch": "^1.0.0",
    "pinia": "^2.0.0",
    "vue": "^3.4.0",
    "vue-flow": "^1.0.0",
    "vue-i18n": "^9.0.0",
    "xterm": "^5.0.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.0.0",
    "@playwright/test": "^1.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/better-sqlite3": "^7.0.0",
    "@types/markdown-it": "^14.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "electron-rebuild": "^3.0.0",
    "electron-vite": "^2.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0",
    "vue-tsc": "^2.0.0"
  }
}