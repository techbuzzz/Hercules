# Hercules Studio environment variables (optional, for dev)
# In production, Studio reads settings from userData/settings.json

# Dev: override agent URL for testing (default http://localhost:8421)
# STUDIO_AGENT_URL=http://localhost:8421

# Dev: override scan range (default 8421-8521)
# STUDIO_SCAN_START=8421
# STUDIO_SCAN_END=8521