{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Supervisor": {
    "ApiBaseUrl": "http://127.0.0.1:8421",
    "ApiKey": "dev-system-key",
    "RestartPollSeconds": 5,
    "RestartGraceSeconds": 10,
    "UnhealthyThreshold": 3,
    "RestartCooldownSeconds": 30,
    "StatusPort": 8479,
    "LogDirectory": "logs",
    "AutoStart": false,
    "Agents": [
      {
        "Name": "main",
        "Primary": true,
        "Command": "Hercules.WebApi/bin/Debug/net10.0/Hercules.WebApi.exe",
        "Arguments": [],
        "WorkingDirectory": "../agent",
        "HealthUrl": "http://127.0.0.1:8421/api/health",
        "HealthIntervalSeconds": 15,
        "AutoRestart": true,
        "Environment": {
          "ASPNETCORE_ENVIRONMENT": "Development"
        }
      }
    ]
  }
}