# ──────────────────────────────────────────────────────────────────────────────
# Hercules Edge Provisioning — Environment Template
# Copy this file to provision.env and fill credentials before starting.
# NEVER commit provision.env with real secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── LLM Configuration ────────────────────────────────────────────────────────
HERCULES_LLM__PROVIDER=yandexgpt
HERCULES_LLM__YANDEXGPT__FOLDERID=ВСТАВЬТЕ_FOLDER_ID
HERCULES_LLM__YANDEXGPT__APIKEY=ВСТАВЬТЕ_IAM_КЛЮЧ

# ── Enrollment ──────────────────────────────────────────────────────────────
# URL of the fleet management server (optional — for centralised identity)
HERCULES_EDGE__ENROLLMENT_URL=
# Pre-shared enrollment token (auto-generated on first boot)
HERCULES_EDGE__ENROLLMENT_TOKEN=
# Hardware device ID (MAC address or serial, auto-detected by first-boot.sh)
HERCULES_EDGE__DEVICE_ID=
# Set to 'true' after successful enrollment
HERCULES_EDGE__ENROLLED=false

# ── Security ────────────────────────────────────────────────────────────────
HERCULES_SECURITY_OPS__ENABLED=true
HERCULES_SECURITY_OPS__AUTO_ROTATE_IDENTITY=true
HERCULES_SECURITY_OPS__IDENTITY_STORAGE_PATH=/data/security/identity
HERCULES_SECURITY_OPS__CERTIFICATE_STORAGE_PATH=/data/security/certs

# ── Storage ─────────────────────────────────────────────────────────────────
HERCULES_STORAGE__DATAROOT=/data
HERCULES_STORAGE__SKILLSDIR=/data/skills
HERCULES_STORAGE__MEMORYDIR=/data/memory
HERCULES_STORAGE__SQLITEFILE=/data/sessions.db

# ── Mesh ───────────────────────────────────────────────────────────────────
HERCULES_MESH__ENABLED=true
HERCULES_MESH__DISCOVERY__ENABLEMDNS=false
